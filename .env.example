# Variables de Tilopay — EJEMPLO, sin valores reales.
#
# En Cloudflare Pages se cargan en: Settings → Variables and Secrets
# (una vez para "Production" y otra para "Preview"). Ver docs/TILOPAY.md.
# Para desarrollo local con `wrangler pages dev`, copiá este archivo a
# `.dev.vars` (ignorado por git) y completalo con credenciales de SANDBOX.
# Nunca subas valores reales al repositorio.

# "sandbox" o "production". En production, además debe estar
# TILOPAY_INTEGRATION_VERIFIED=true o los pagos responden 503.
TILOPAY_ENV=sandbox

# URL base de la API de Tilopay, sin barra final.
# [NO VERIFICADO] Confirmar en la documentación oficial cuál es la URL de
# sandbox y cuál la de producción. Ejemplo de forma: https://<host>/api/v1
TILOPAY_BASE_URL=

# Credenciales de API (panel de Tilopay / registro de desarrolladores).
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
TILOPAY_API_KEY=

# Secreto aleatorio (mín. 32 caracteres) que va como último segmento de la
# URL del webhook: https://<tu-dominio>/api/tilopay/webhook/<TOKEN>
# Generar con:  openssl rand -hex 32
TILOPAY_WEBHOOK_TOKEN=

# Solo producción: poner "true" DESPUÉS de completar la lista de verificación
# de docs/TILOPAY.md (adaptador confirmado contra la doc oficial).
TILOPAY_INTEGRATION_VERIFIED=false

# Opcional: Web App de Apps Script que registra pedidos pagados en la hoja
# (ver docs/ORDER-LOG-SHEET.md). Vacío = desactivado.
ORDER_LOG_URL=
# Igual a la propiedad TOKEN del Apps Script. Solo en Cloudflare, nunca en el navegador.
ORDER_LOG_TOKEN=
